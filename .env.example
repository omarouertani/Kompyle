# ─────────────────────────────────────────────────────────────────────────────
# Kompyle — Example environment variables
#
# Copy this file to `.env.local` and fill in the values you need:
#   cp .env.example .env.local
#
# NOTE: AI provider API keys are NOT set here. Kompyle uses a Bring Your Own Key
# (BYOK) model — you enter provider keys directly in the web UI, where they are
# stored only in your browser's localStorage. The only exception is OpenRouter,
# which can optionally use a server-side fallback key (see below).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (optional) ──────────────────────────────────────────────────────
# PostgreSQL connection string. If unset, Kompyle falls back to an in-memory
# session mode (editing and PDF export work, but data does not persist).
# The docker-compose setup provides this value automatically.
DATABASE_URL="postgresql://kompyle:kompyle_dev@localhost:5432/kompyle"

# ─── Site URL (optional) ──────────────────────────────────────────────────────
# Public base URL of your deployment. Used to build absolute OpenGraph / Twitter
# card image URLs for link previews. Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── OpenRouter (optional) ────────────────────────────────────────────────────
# Server-side fallback key for the OpenRouter provider. Users can still provide
# their own OpenRouter key in the UI; this is only used when no UI key is set.
# Get a key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional headers sent to OpenRouter for attribution / rankings.
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=
